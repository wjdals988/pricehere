<?xml version="1.0" encoding="utf-8"?>
<!--
  v2.9 시작 화면 아이콘(B안 "로고 착지").
  큰 판 대신 가운데에 작은 타일만 그린다(108 캔버스 중 48). 바깥은 투명이라 기기의 아이콘 마스크와 상관없이
  타일 모양 그대로 보인다. 타일은 살짝 커지며 자리 잡고, 이후 MainActivity.holdSplash가 헤더 로고 자리로 날려 보낸다.
  타일 크기(48/108)는 MainActivity.SPLASH_TILE_FRACTION과 같아야 착지 위치가 맞는다.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <group android:name="tile" android:pivotX="54" android:pivotY="54" android:scaleX="0.9" android:scaleY="0.9">
                <!-- 바닥 그림자: 아래로 1.5 내린 옅은 판 -->
                <path android:fillColor="#260B3C32"
                    android:pathData="M44,31.5h20a14,14 0,0 1,14 14v20a14,14 0,0 1,-14 14h-20a14,14 0,0 1,-14 -14v-20a14,14 0,0 1,14 -14z" />
                <path android:pathData="M44,30h20a14,14 0,0 1,14 14v20a14,14 0,0 1,-14 14h-20a14,14 0,0 1,-14 -14v-20a14,14 0,0 1,14 -14z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="linear" android:startX="34" android:startY="30" android:endX="74" android:endY="78">
                            <item android:offset="0.0" android:color="#FF17A08C" />
                            <item android:offset="0.55" android:color="#FF0B6E5E" />
                            <item android:offset="1.0" android:color="#FF05433A" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- 위쪽 빛 띠 -->
                <path android:pathData="M44,30h20a14,14 0,0 1,14 14v2h-48v-2a14,14 0,0 1,14 -14z">
                    <aapt:attr name="android:fillColor">
                        <gradient android:type="linear" android:startX="54" android:startY="30" android:endX="54" android:endY="46">
                            <item android:offset="0.0" android:color="#33FFFFFF" />
                            <item android:offset="1.0" android:color="#00FFFFFF" />
                        </gradient>
                    </aapt:attr>
                </path>
                <!-- ₩: 런처 아이콘의 마크를 타일 크기(48/72)로 줄인다 -->
                <group android:pivotX="54" android:pivotY="54" android:scaleX="0.667" android:scaleY="0.667">
                    <group android:translateY="2">
                        <path android:pathData="M36.2,37 L45.1,72.7 L54,44.6 L62.9,72.7 L71.8,37"
                            android:strokeColor="#5905433A" android:strokeWidth="7.6"
                            android:strokeLineCap="round" android:strokeLineJoin="round" />
                        <path android:pathData="M32.8,52.3 L75.2,52.3 M32.8,62.5 L75.2,62.5"
                            android:strokeColor="#5905433A" android:strokeWidth="5.1" android:strokeLineCap="round" />
                    </group>
                    <path android:pathData="M36.2,37 L45.1,72.7 L54,44.6 L62.9,72.7 L71.8,37"
                        android:strokeColor="#FFFFFFFF" android:strokeWidth="7.6"
                        android:strokeLineCap="round" android:strokeLineJoin="round" />
                    <path android:pathData="M32.8,52.3 L75.2,52.3 M32.8,62.5 L75.2,62.5"
                        android:strokeColor="#FFE6F8F2" android:strokeWidth="5.1" android:strokeLineCap="round" />
                </group>
            </group>
        </vector>
    </aapt:attr>
    <target android:name="tile">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.9" android:valueTo="1"
                    android:duration="380" android:interpolator="@android:interpolator/decelerate_cubic" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.9" android:valueTo="1"
                    android:duration="380" android:interpolator="@android:interpolator/decelerate_cubic" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
