<?xml version="1.0" encoding="utf-8"?>
<!--
  시작 화면(Android 12+) 아이콘. 런처 아이콘과 같은 판·₩를 쓰되,
  ₩의 W 획이 먼저 그려지고 두 가로줄이 뒤따르며, 마크가 살짝 커지며 자리 잡는다(약 0.6초).
  시스템이 원으로 잘라 보여주므로 판은 정사각형으로 채운다.
-->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path android:pathData="M0,0h108v108h-108z">
                <aapt:attr name="android:fillColor">
                    <gradient android:type="linear" android:startX="20" android:startY="10" android:endX="88" android:endY="100">
                        <item android:offset="0.0" android:color="#FF17A08C" />
                        <item android:offset="0.55" android:color="#FF0B6E5E" />
                        <item android:offset="1.0" android:color="#FF05433A" />
                    </gradient>
                </aapt:attr>
            </path>
            <group android:name="mark" android:pivotX="54" android:pivotY="54" android:scaleX="0.86" android:scaleY="0.86">
                <group android:translateY="2">
                    <path android:name="w_shadow"
                        android:pathData="M36.2,37 L45.1,72.7 L54,44.6 L62.9,72.7 L71.8,37"
                        android:strokeColor="#5905433A" android:strokeWidth="7.6"
                        android:strokeLineCap="round" android:strokeLineJoin="round"
                        android:trimPathEnd="0" />
                    <path android:name="bars_shadow"
                        android:pathData="M32.8,52.3 L75.2,52.3 M32.8,62.5 L75.2,62.5"
                        android:strokeColor="#5905433A" android:strokeWidth="5.1"
                        android:strokeLineCap="round" android:trimPathEnd="0" />
                </group>
                <path android:name="w"
                    android:pathData="M36.2,37 L45.1,72.7 L54,44.6 L62.9,72.7 L71.8,37"
                    android:strokeColor="#FFFFFFFF" android:strokeWidth="7.6"
                    android:strokeLineCap="round" android:strokeLineJoin="round"
                    android:trimPathEnd="0" />
                <path android:name="bars"
                    android:pathData="M32.8,52.3 L75.2,52.3 M32.8,62.5 L75.2,62.5"
                    android:strokeColor="#FFE6F8F2" android:strokeWidth="5.1"
                    android:strokeLineCap="round" android:trimPathEnd="0" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="w">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:duration="380" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="w_shadow">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:duration="380" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="bars">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:startOffset="240" android:duration="260" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="bars_shadow">
        <aapt:attr name="android:animation">
            <objectAnimator android:propertyName="trimPathEnd" android:valueFrom="0" android:valueTo="1"
                android:startOffset="240" android:duration="260" android:interpolator="@android:interpolator/fast_out_slow_in" />
        </aapt:attr>
    </target>
    <target android:name="mark">
        <aapt:attr name="android:animation">
            <set>
                <objectAnimator android:propertyName="scaleX" android:valueFrom="0.86" android:valueTo="1"
                    android:duration="560" android:interpolator="@android:interpolator/overshoot" />
                <objectAnimator android:propertyName="scaleY" android:valueFrom="0.86" android:valueTo="1"
                    android:duration="560" android:interpolator="@android:interpolator/overshoot" />
            </set>
        </aapt:attr>
    </target>
</animated-vector>
