<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/w_bg"
    android:padding="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/w_cur_usd" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp"
            android:layout_marginEnd="4dp" android:background="@drawable/w_chip"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/w_muted"
            android:text="USD" android:maxLines="1" />
        <TextView android:id="@+id/w_cur_eur" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp"
            android:layout_marginEnd="4dp" android:background="@drawable/w_chip"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/w_muted"
            android:text="EUR" android:maxLines="1" />
        <TextView android:id="@+id/w_cur_jpy" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp"
            android:layout_marginEnd="4dp" android:background="@drawable/w_chip"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/w_muted"
            android:text="JPY" android:maxLines="1" />
        <TextView android:id="@+id/w_cur_czk" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:gravity="center" android:paddingTop="7dp" android:paddingBottom="7dp"
            android:layout_marginEnd="4dp" android:background="@drawable/w_chip"
            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/w_muted"
            android:text="CZK" android:maxLines="1" />
        <ImageView android:id="@+id/w_refresh" android:layout_width="22dp" android:layout_height="22dp"
            android:src="@drawable/w_refresh" android:contentDescription="새로고침" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:background="@drawable/w_hero"
        android:padding="7dp" android:layout_marginTop="6dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <!-- 식이 길어지면 앞쪽을 생략한다. 방금 누른 끝부분이 보여야 하고,
                 결과 금액을 밀어내지 않도록 폭 상한을 둔다. start 생략은 singleLine에서만 동작한다. -->
            <TextView android:id="@+id/w_amount" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxWidth="150dp"
                android:textSize="17sp" android:textStyle="bold" android:textColor="@color/w_text"
                android:singleLine="true" android:ellipsize="start" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="→" android:textSize="15sp" android:textColor="@color/w_muted"
                android:paddingStart="9dp" android:paddingEnd="9dp" />
            <TextView android:id="@+id/w_result" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textSize="22sp" android:textStyle="bold"
                android:textColor="@color/w_text" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <TextView android:id="@+id/w_rate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="4dp" android:textSize="11sp" android:textColor="@color/w_muted"
            android:maxLines="1" />
    </LinearLayout>
    <!-- 5열: 숫자 3 · 기능 1 · 연산자 1. 연산자는 계산기 관례대로 맨 오른쪽 열에 모으고 바탕색으로 구분한다. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:paddingTop="4dp">
        <TextView android:id="@+id/k7" style="@style/WKey.Digit" android:text="7" />
        <TextView android:id="@+id/k8" style="@style/WKey.Digit" android:text="8" />
        <TextView android:id="@+id/k9" style="@style/WKey.Digit" android:text="9" />
        <TextView android:id="@+id/kdel" style="@style/WKey.Fn" android:text="⌫" android:contentDescription="지우기" />
        <TextView android:id="@+id/kdiv" style="@style/WKey.Op" android:text="÷" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:paddingTop="4dp">
        <TextView android:id="@+id/k4" style="@style/WKey.Digit" android:text="4" />
        <TextView android:id="@+id/k5" style="@style/WKey.Digit" android:text="5" />
        <TextView android:id="@+id/k6" style="@style/WKey.Digit" android:text="6" />
        <TextView android:id="@+id/kclr" style="@style/WKey.Fn" android:text="C" android:contentDescription="모두 지우기" />
        <TextView android:id="@+id/kmul" style="@style/WKey.Op" android:text="×" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:paddingTop="4dp">
        <TextView android:id="@+id/k1" style="@style/WKey.Digit" android:text="1" />
        <TextView android:id="@+id/k2" style="@style/WKey.Digit" android:text="2" />
        <TextView android:id="@+id/k3" style="@style/WKey.Digit" android:text="3" />
        <TextView android:id="@+id/kdot" style="@style/WKey.Digit" android:text="." />
        <TextView android:id="@+id/ksub" style="@style/WKey.Op" android:text="−" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="horizontal" android:paddingTop="4dp">
        <TextView android:id="@+id/k0" style="@style/WKey.Digit" android:text="0" />
        <TextView android:id="@+id/k00" style="@style/WKey.Digit" android:text="00" />
        <TextView android:id="@+id/k000" style="@style/WKey.Digit" android:text="000" android:textSize="19sp" />
        <TextView android:id="@+id/kopen" style="@style/WKey.Fn" android:text="열기" android:textSize="15sp" android:contentDescription="앱 열기" />
        <TextView android:id="@+id/kadd" style="@style/WKey.Op" android:text="+" />
    </LinearLayout>
</LinearLayout>
